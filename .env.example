# 可选：mock | qwen | openai
IMAGE_ANALYSIS_PROVIDER=mock

# 国内默认方案：阿里云百炼 Qwen3-VL
# 密钥仅服务端读取，不要添加 NEXT_PUBLIC_ 前缀。
DASHSCOPE_API_KEY=
QWEN_VISION_MODEL=qwen3-vl-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_INPUT_COST_PER_1M=
QWEN_VISION_OUTPUT_COST_PER_1M=

# 保留的 OpenAI Provider；未使用时可留空。
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_VISION_INPUT_COST_PER_1M=
OPENAI_VISION_OUTPUT_COST_PER_1M=

NEXT_PUBLIC_MOCK_MODE=true

# 第七阶段：未选择云供应商前保持 disabled。
ACCOUNT_PROVIDER=disabled
CLOUD_SYNC_PROVIDER=disabled
APP_ORIGIN=http://localhost:3000
